# Postgres ulanish manzili (Neon, Supabase va h.k.). Bo'sh qolsa — vaqtinchalik ichki baza ishlatiladi.
DATABASE_URL=

# Admin panelga kirish. ADMIN_PASSWORD bo'sh qolsa — demo rejim (admin / admin123)
ADMIN_LOGIN=admin
ADMIN_PASSWORD=
# Cookie imzosi uchun uzun tasodifiy satr (bo'sh qolsa DATABASE_URL'dan olinadi)
SESSION_SECRET=

# Yangi qabul haqida Telegram xabari (ixtiyoriy)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
